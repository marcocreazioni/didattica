<!doctype html>
<html lang="en">
    <head>
        <title>Title</title>
        <!-- Required meta tags -->
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />

        <!-- Bootstrap CSS v5.2.1 -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
            crossorigin="anonymous"
            
        />
        <style>
            .accordion-button {background-color: aqua;
                               

            }
            .accordion-button:active, .accordion-button:hover  {
                background-color: blanchedalmond;
            }
                
        </style>
    </head>

    <body>
        <h1 class="text-center">Oggetti Bootstrap</h1>
        <div class="container">
           <div class="row">
             <div class="col-xl-6">
                <!--inizio accordion-->
                <div class="accordion" id="accordionExample">
                    <!--ogni elmeneto dell'accordion e un item-->
                    <div class="accordion-item">
                         <!-- testata dell'accordion -->
                        <h2 class="accordion-header">
                            <!--per modificare il pulsante di attivazione cambiare
                            le proprieta button-->
                        <button class="accordion-button bg-light p-2" 
                        type="button" data-bs-toggle="collapse" 
                        data-bs-target="#collapseOne" aria-expanded="true"
                        aria-controls="collapseOne">
                         Come comprare nel nostro sito?
                        </button>
                      </h2>
                         <!--contenuto che si apre-->
                      <div id="collapseOne" class="accordion-collapse collapse show"
                       data-bs-parent="#accordionExample">
                        <!--corpo del collapse-->
                        <div class="accordion-body">
                          <p>Puoi acquistare solo con carta di credito</p>
                        </div>
                      </div>
                    </div>

                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light p-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                          Visualizza il video
                        </button>
                      </h2>
                      <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <iframe width="1250" height="703" src="https://www.youtube.com/embed/R--e-PDoX58" title="Un Giorno da Pecora del 17/04/2025" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                        </div>
                      </div>
                    </div>

                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button class="accordion-button collapsed p-2 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                          Controlla il tracciato di spedizione
                        </button>
                      </h2>
                      <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                          <!--inserimento di una card-->
                          <div class="card" style="width: 100%;">
                            <img src="https://cdn.pixabay.com/photo/2025/03/07/14/18/waterfall-9453143_960_720.jpg" class="card-img-top" alt="...">
                            <div class="card-body">
                              <h5 class="card-title">Card title</h5>
                              <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                              <a href="#" class="btn btn-primary">Go somewhere</a>
                            </div>
                          </div>
                      </div>
                    </div>

                  </div> 
<!--accordion item nuovo-->
<div class="accordion-item">
    
    <h2 class="accordion-header">
        <!--per aggiungere un nuovo elemento definiamo un nuovo collegamento al data-bs-target "#collpaseFour" e
        successivamente modificare anche contestulmente l'id dell'oggetto aparto dal data-bs-target nel nostro caso "collapseFour" senza
        l'uso del cancelletto-->
      <button class="accordion-button collapsed p-2 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseThree">
 Compre online sempre da noi </button>
    </h2>
        <!--modifichiamo quindi l'id-->
    <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <!--inserimento conteiner bootstrap-->
        <div class="container-fluid">
           <div class="row">
              <div class="col-6">
                  
                   <!--inserimento di una card-->
                   <div class="card" style="width: 100%;">
                    <div class="card-body">
                      <h5 class="card-title">Card title</h5>
                      <h6 class="card-subtitle mb-2 text-body-secondary">Card subtitle</h6>
                      <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                      <a href="#" class="card-link">Card link</a>
                      <a href="#" class="card-link">Another link</a>
                    </div>
                  </div>
              </div>
