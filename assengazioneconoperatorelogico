<h2>Logical Assegnazione con valori logici</h2>
<h3>The &&= Operator</h3>

<p id="stampat"></p>
<p id="demo"></p>

<script>
t = prompt("Quanto hai preso all'esame", " ");
z = t > 18;
stampat.innerHTML = z;
//se z da come risultato vero deve assegna a z il valore 10, se non è vero scrivero false
// &&= and assegna un valore solo se t da come risultato "true" mentre ||= assogne un valore alla variabile solo se t da
// come risultato true
y = z &&= "Sei stato promosso";
if (z = "false"){ 
y = "sei stato bocciato diamine";
}
demo.innerHTML = "il valore è: " + y;
</script>

