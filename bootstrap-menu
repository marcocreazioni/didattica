    <body>
        
            <!--proprieta navbar (expand allarga le voci del menu)(navbar dark da lo schema di colore
            in modalita dark) bg-dark aggiunto allo schema ci da lo sfondo-->
            <nav class="navbar navbar-expand-xl navbar-dark sticky-top" style="background-image: linear-gradient(orange,red);">

                <div class="container-fluid">
                  <a class="navbar-brand" href="#">
                    <img src="https://getbootstrap.com/docs/5.2/assets/brand/bootstrap-logo.svg" alt="Bootstrap" width="30" height="24">

                            Azienda</a>
