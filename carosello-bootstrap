<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
<style>
* { box-sizing: border-box;}
body {padding:0px;
      margin: 0px 
}
/*logica dei framework */
/* colori del mio framework */
.mela {color:lightpink }
.arancio {color: lightsalmon}
/* allineamento */
.start {text-align: left}
.center {text-align: center}
.end {text-align: right}
/*larghezze*/
.cento {width:100%}
.dueterzi {width:75%}
/*margini*/
.destra10 {margin-right:10px;
           padding-right: 10px;
}                       
.sinistra10 {margin-left:10px;
             padding-left:10px; 
}
/*framework */


</style>
<!--css di bootstrap-->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</head>
<body>
<nav class="navbar navbar-expand-lg sticky-top" style="background-color:aquamarine">
 
    <div class="container-fluid">
        <!--icone-->
    <img src="https://getbootstrap.com/docs/5.3/assets/brand/bootstrap-logo.svg" alt="Bootstrap" width="30" height="24">
           <!--icone bootstrap-->
    <a class="navbar-brand" href="#">Il mio sito</a>
       <!--gestione del menu hamburger data-bs-target="#navbarSupportedContent" e collegato al contenitore con lo stesso id  -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
<!--blocco menu-->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
      <!---voce del menu-->
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="#">Home</a>
        </li>
        <!--nuova voce del menu-->
        <li class="nav-item">
            <!--active evidenzia la pagina dove mi trovo-->
          <a class="nav-link active" aria-current="page" href="#">Servizi</a>
        </li>


        <li class="nav-item">
          <a class="nav-link" href="#">Link</a>
        </li>
        <!--menu a discesa-->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Primo elemento
          </a>
             <!--corpo del menu a disesa-->
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Action</a></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Secondo elemento
          </a>
             <!--corpo del menu a disesa-->
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Action</a></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
            <li><a class="dropdown-item" href="#">Nuova voce del menu</a></li>
          </ul>
        </li>

        <li class="nav-item">
            <!--aggiungendo disabled ottengo un menu discabilitato-->
          <a class="nav-link disabled" aria-disabled="true">Disabled</a>
        </li>

      </ul>
<!--modulo di ricerca-->
      <form class="d-flex" role="search">
        <input class="form-control me-2" type="search" placeholder="Ricerca ora" aria-label="Search"/>
 <!--buottone di ricerca-->       
        <button class="btn btn-info" type="submit">Ricerca</button>
      
    </form>


    </div>
  </div>
</nav>
<!--inizio codice carosello (carousel fade Le immagini vanno in sovrapposizione) aggiungendo
attributo data bs ride viene attivato l'autoplayng-->
<div id="mia" class="carousel slide" data-bs-ride="carousel">
  <!--indicatori-->
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#mia" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#mia" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#mia" data-bs-slide-to="2" aria-label="Slide 3"></button>
    <!--se aggiungo un nuovo item devo aggiungere un altro indicatore data-bs-slide-to="3" e una aria-label successivo  -->
    <button type="button" data-bs-target="#mia" data-bs-slide-to="3" aria-label="Slide 4"></button>
  </div>
  <!--fine indicatori-->
  <!--inizio del blocco carosello-->
  <div class="carousel-inner">
<!--primo elemento del carsello (active e quello in carica della pagina)-->
    <div class="carousel-item active">
      <img src="https://cdn.pixabay.com/photo/2025/10/04/18/08/chameleon-9873577_960_720.jpg" class="d-block w-100" alt="camaleonte su ramo" height="420px">
      <!--rimuovere la classe d-none per mostrare la descrizione-->
      <div class="carousel-caption d-md-block">
       <!--contenuto della caption-->
       <a href="#" class="btn btn-warning">Clicca qui</a>
       <p>Scopri la nostra selezione di prodotti</p>
      </div>
    </div>
<!--fine primo elemento-->
 <!--secondo elemento -->
    <div class="carousel-item">
      <img src="https://cdn.pixabay.com/photo/2025/09/29/15/39/tractor-9862727_960_720.jpg" class="d-block w-100" alt="..." height="420px">
      <div class="carousel-caption d-md-block">
 
        <div class="card" style="background-color: transparent;color:white">
          <div class="card-body">
            <h5 class="card-title">Special title treatment</h5>
            <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
            <a href="#" class="btn btn-primary">Go somewhere</a>
          </div>
         </div>

      </div>
    </div>
<!--fine secondo elemento-->
<!--terzo elemento -->
    <div class="carousel-item">
      <img src="https://cdn.pixabay.com/photo/2025/08/27/07/33/heart-9799423_960_720.jpg" class="d-block w-100" alt="..." height="420px">
      <div class="carousel-caption  d-md-block">
        <h5>Third slide label</h5>
        <p>Some representative placeholder content for the third slide.</p>
      </div>
    </div>
     <!--fine terzo elemento-->
     <!--quarto elemento-->
    <div class="carousel-item">
      <img src="https://cdn.pixabay.com/photo/2025/09/19/16/18/iguanaphotography-9843469_960_720.jpg" class="d-block w-100" alt="..." height="420px">
      <div class="carousel-caption  d-md-block">
        <h5>Quarta</h5>
        <p>Some representative placeholder content for the third slide.</p>
      </div>
    </div>
  
   
  
  </div>
 <!--sopra di chiusura carousel inner-->
  


  
  <!--blocco di navigazione tra gli elementi-->
  <button class="carousel-control-prev" type="button" data-bs-target="#mia" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#mia" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
  <!--fine del blocco di navigazione-->
</div>
<!--fine del carosello-->








<!--javascript bootstrap-->
</body>
</html>
