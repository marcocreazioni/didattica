<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body {margin: 0px;
      padding: 0px;
    }
#voceadiscesa a {color:rgb(67, 7, 135) 

}

</style>
</head>
<body>
<!--menu di navigazione-->
            <!--la classe modifica le proprieta della navbar 
            (bg body indica lo sfondo della navbar o bg-info o success) 
            rimuovendo il bg posso applicare qualsiasi sfondo
            aggiungendo la classe fixed-top-e-bottom mettiamo la barra in position fixed
            per farlo scrollare con la pagina possiamo aggiungere la classe sticy-top o bottom-->
<nav class="navbar navbar-expand-lg " style="background-image: linear-gradient(90deg,orange,red);">

  <div class="container-fluid">
    
<!--il navbar brand e dedicato a icone e titolo del sito-->
    <img src="https://getbootstrap.com/docs/5.3/assets/brand/bootstrap-logo.svg" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">

    <a class="navbar-brand" href="#">Mr. Red</a>
     <!--qui posso inserire un icona o prima dell'oggetto navbarbrand-->
    <!--Hamburger Menu-->
     <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
     <!--Fine del menu hamburger-->
     <!--area menu-->
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
       <!--elenco del mun-->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
             <!--voce del menu-->
        <li class="nav-item">
          <a class="nav-link active"  href="#">Home</a>
        </li>
            <!--fine voce del menu-->   
        <li class="nav-item">
               <!-- active identifica la pagina attuale , al quale facoltativamente si
                aggiunge l'attributo aria current-->
          <a class="nav-link active" aria-current="page" href="#">Servizi</a>
        </li>
              <!--voce del menu nuovo-->    
        <li class="nav-item">
          <a class="nav-link"  href="#">Chi siamo</a>
        </li>
              
        <!--blocco del menu a discesa-->     
        <li class="nav-item dropdown" id="voceadiscesa">
            <!--voce primaria-->
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Menu a discesa 1
           </a>
           <!--elementi che compongono il menu a discesa-->
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Action</a></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
            <!--divisore del menu  dropdown-divider-->
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
          </ul>
            <!--fine del menu a discesa-->
        </li>
         <!--finede dalla voce a discesa-->
          <!--blocco del menu a discesa-->     
        <li class="nav-item dropdown" id="voceadiscesa">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Menu a discesa 2
          </a>
          <ul class="dropdown-menu">
            <!--elementi del menu a discesa dropdown-item-->
            <li><a class="dropdown-item" href="#">Action</a></li>
            <li><a class="dropdown-item" href="#">Action 2</a></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
           
            <li><a class="dropdown-item" href="#">Something else here</a></li>
          </ul>
        </li>
         <!--finede dalla voce a discesa-->


        <li class="nav-item">
            <!--con la classe disabled disattivo il click su una pagina-->
          <a class="nav-link disabled" aria-disabled="true">Disabled</a>
        </li>
      </ul>
<!--blocco di ricerca-->
      <form class="d-flex" role="search">
        <!--casella di testo per inserimento-->
        <input class="form-control me-2" type="search" placeholder="Cerca" aria-label="Search"/>
         <!--bottone di ricerca btn classe per i botton mentre il colore e la tipologia 
         segue questa classe btn-outline-success-->
        <button class="btn btn-warning" type="submit">Cerca </button>
      </form>

    </div>
        <!--area menu-->
    <!--fine del contenitore-->
  </div>
</nav>
 <!--fine del codice navbar-->   
<!--carosello bootstrap per l'autoplay aggiungere l'attributo
 data-bs-ride="carousel"-->
<div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
<!--indicatori delle immagini del carosello-->
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
 <!--aggiunta di un nuovo indicatore modifica l'attributo data-bs-slide-to="4" facoltativamente modificate
 l'attributo  aria-label="Slide 4"-->
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="3" aria-label="Slide 4"></button>

</div>

  <div class="carousel-inner">
<!--voce del carosello-->
    <div class="carousel-item active">
      <img src="https://cdn.pixabay.com/photo/2025/02/21/10/33/cat-9421720_960_720.jpg" class="d-block w-100" style="height: 270px;" alt="...">
      <!--per mostrare la caption della slide rimuovere la classe d-none-->
      <div class="carousel-caption d-md-block">
        <!--contenuto della caption si inserisce qui-->
        <h5>First slide label</h5>
        <p>Some representative placeholder content for the first slide.</p>
      
      </div>

    </div>
<!--termin della slide del carosello-->
        <!--aggiungendo a ciascun elemento l'attributo data-bs-interval="10000" stabilisco
        la durata in microsecondi di ciasuna slide-->
    <div class="carousel-item" data-bs-interval="5000">
      <img src="https://cdn.pixabay.com/photo/2025/09/10/12/32/tokyo-9826329_960_720.jpg" class="d-block w-100" style="height: 270px;" alt="...">
      <div class="carousel-caption d-md-block">
        <p>Some representative placeholder content for the second slide.</p>
         <a href="#" class="btn btn-info">Clicca qui</a>
        </div>
    </div>

    <div class="carousel-item">
      <img src="https://cdn.pixabay.com/photo/2025/02/05/08/07/man-9383629_960_720.jpg" style="height: 270px;" class="d-block w-100" alt="...">
      <div class="carousel-caption d-md-block">
          <div class="card" style="background-color:rgba(253, 253, 252, 0.206)">
  
  <div class="card-body">
    <h5 class="card-title">Special title treatment</h5>
    <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
    <a href="#" class="btn btn-primary">Go somewhere</a>
  </div>
</div>


       </div>
    </div>
<!--nuova voce del caroselleo-->
     <div class="carousel-item">
      <img src="https://cdn.pixabay.com/photo/2025/09/12/16/42/dog-9830813_960_720.jpg"  style="height: 270px;" class="d-block w-100" alt="...">
      <div class="carousel-caption d-md-block">
        <h5>Four slide label</h5>
        <p>Some representative placeholder content for the second slide.</p>
      </div>
    </div>


  </div> <!--aggiungi le altre slide prima della chiusura del carosello-->
  <!--fine del raggruppamento carosello-->
<!--freccia indietro-->
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
<!--freccia avanti-->
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>

</div>
<!--fine del carosello-->




    
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
