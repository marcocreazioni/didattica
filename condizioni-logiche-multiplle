<h1>Form</h1>

<label>Prezzo senza iva</label><br>
<input type="number" id="noniva"> €
<br>

<button type="button"onclick="stampainformazioni()">Invio</button>

<p id="daticompleti">Dati completi</p>

<script>
function stampainformazioni() {

var noiva = document.getElementById("noniva").value;
//PRima condizione
var x = noiva == 0;
//Seconda Condizione
var y = noiva <= 0;

   //if + (condizione che si deve verifica)se il risultato della formule = vero) { operazione da svolgere}  
   // aggiungendo l'operatore logico && entrambe le formule devono restituire un riusultato vero, con l'operatore
   // or || almeno 1 delle due formule deve restituiri un risultato vero
   if (noiva == 0 || noiva <= 0 || typeof(noiva) == "string") { 
    
    daticompleti.innerHTML =  "Attenzione ti Maledico!! non hai inserito un importo corretto" + " " + x + " " + y;
   
   } 
   //else + {per tutti gli altri casi in cui la formula condizionale restituisce falso svolgero le operazioni in {}
   else {
   
   
var noiva = noiva * 1.23;

daticompleti.innerHTML =  "Prezzo Ivato <br>" + noiva + "€" + " " + x + " " + y;
       }

}

</script>
