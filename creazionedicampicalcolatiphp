<?php
/*connessine al database */
$servername = "localhost";
$username = "root";
$password = "";
$database = "archivio";

$connessione = mysqli_connect($servername, $username, $password, $database);
// Verrifica la connessione
if (!$connessione) {
  die("Connessione al database: " . mysqli_connect_error());
}

/*creazione della tabella merci in archivio */
$sqlarchivio = "CREATE TABLE prodotti    (ID INT PRIMARY KEY NOT NULL AUTO_INCREMENT UNIQUE,
                                       MERCE VARCHAR(120) NOT NULL,
                                       /* DECIMAL (quantita di numeri interi, quantita di decimali*/
                                       PREZZO DECIMAL(65,2) NOT NULL,
                                       IVA DECIMAL(12,2) NOT NULL,
                                       /* DECIMAL -> FLOAT + GENERATED ALWAYS PERMETTE DI GENERARE AS (assimili i campi da calcolare)
                                       (CAMPI A + asterisco  /   - ) */
                                       PREZZOIVATO DECIMAL(12,2) GENERATED ALWAYS AS (PREZZO * 0.22)

                                       /* PREZZOIVATO AS MERCE * IVA  ma MariaDB vuole GENERETED ALWAYS IN AGGIUNTA A AS*/ 
                                        )"; 


