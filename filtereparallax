<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filtri</title>
<style>
body {margin: 0px;
      padding: 0px;            }    
img {border-radius: 15px;
/* sconstamento x - y e sfocature e il colore dell'ombreggiature*/
     box-shadow:1px 1px 1px black; 
/* filtri sulle immagini, 
sfocatura blur
brightness luminosita (1 - 10)
contrast contrasto (1 -10) 
drop-shadow e box-shadow interno ed esterno (3/4 valori incluso il colore)
saturate (1-10) aumenta quantita di colori     
invert () crea un effetto in negativo
hue rotate(0deg) cambia tonalita all'immagine scegliendo un angolo di rotazione
sepia() applica un effetto seppia 
opacity (70%)
 */
     filter: hue-rotate(240deg) sepia() opacity(30%);
 /* applicazione dei livelli con z-index: -1 l'immagine va sullo sfondo
    0 è il livello predefini 1 e 2 per i lievelli superiori
    (attenzione i livelli superiori variano in base ad alcuni contesti*/
     z-index: 0;
     padding: 2px;
     margin:2px;
     width: 50%; 
     height: 150px   
}

img:hover {filter:grayscale(0) saturate(4)

}
.testo {margin-top: -50px;
        background-color: aliceblue;
        padding: 5px;

           

}

section { min-height:400px;
         /* con min height: cambia l'altezza minima */
         background-image: url("https://cdn.pixabay.com/photo/2025/07/21/18/26/mountain-9726891_960_720.jpg");
         width: 100%;
         /* combinazione in background properti per ottere il parallax */
         background-attachment: fixed;
      /* Ipotesi A 
         background-position: top;
         background-size:100% 300px; */
      /* Ipotesi B */
         background-position:center;
         background-size:cover;
         background-repeat: no-repeat;

         

}
.top {height: 80px;
      background-color: brown; 

}
.bottom { height: 80px;
          background-color: rgba(5, 5, 242, 0.473);
          margin-top: -200px;
          text-align:center;
          padding-top: 20px;
          color:white;
          font-size:larger;
          
}
.bottom > p {
    filter: opacity(100%)
}
</style>
</head>
<body>
<h2>Filtri</h2> 
    <img src="https://cdn.pixabay.com/photo/2025/08/25/20/04/nature-9796816_960_720.jpg">
   <div class="testo"> <p>IL MIO TESTO</p></div>
   <h2>Effetto Parallax</h2>
<div class="top"></div>
<section></section>
<div class="bottom"><p>Il mio testo</p></div>

</body>
</html>
