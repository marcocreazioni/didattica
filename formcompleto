<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
.box {background-color: aquamarine;
      margin:auto;
      width:85%;
      padding:10px;
      height:auto;

    }


    </style>
</head>
<body>
<h1>Modulo</h1>    
<div class="box">
<!--Form Raccchiude i tag del modulo 
action permette di indicare la destinazionie delle informazioni
insimeme ad action troviamo un altro attributo obbligatorio
e method che definisce il processo di invio delle informazioni
get (preleva->invia (campoxcampo)) task () post (preleva-stampa-invia) 
attributo facoltativi autocompletamento di autocomplete che raccoglie informazione
memorizzate dal browser (attributi di validazione delle informazionilegate a proprieta js)-->
<form action="sendamail.php" method="post" autocomplete="on">
<!--ogni informazione prevede due tag Etichetta label mentre il
secondo e l'input-->
<label for="nome">Nome</label></br>
<!--tag di input con type che rappresenta la tipologia di informazione
e per meglio gestire le informazioni da prelevare si usa name per
selezionare le informazioni da prelevare in php 
ci sono anche altri attributi facoltativi
ad esempio l'obbligatorieta (required) 
e possibile aggiungere dei suggerimenti con (placeholder)
autofocus="on" effetto zoom-->
<input type="text" name="nome" placeholder="metti il tui nome qui" autofocus="on" required></br></br>
<label for="Cognome">Cognome</label></br>
<input type="text" name="cognome" placeholder="metti il tui cognome qui" autofocus="on" required></br></br>
<label for="tel">Telefono</label></br>
<!--pattern obbliga l'utente ad un determinato inserimento [A-z,0-9]{3}-[0-9]{10}" 3 cifre a z incluso numeri
e 10 cifre da 0 a 9 per il type tel-->
<input type="tel" name="tel"  autofocus="on" pattern="[A-z,0-9]{3}-[0-9]{10}" placeholder="+39-1234567890"></br></br>
<label for="codicefiscale">Codice Ficale</label></br>
<!--per inserire un minimo o un massimo di caratteri
usiamo minlenght e maxleght-->
<input type="text" name="nome" 
minlength="16" maxlength="16" required></br></br>
<label for="eta">La tua eta</label></br>
<!--per inserire un minimo o un massimo di numeri
usiamo min e max se vogliamo avanzare con numeri progressivi
di 10 in 10 ad esempio step="10"-->
<input type="number" name="eta" 
min="18" max="99" step="10" required></br></br>
<label for="nascita">Quando sei nato</label></br>
<!--type date (formato gg/mm/aaaa) month (solo mese), week(settimana)
datetime (campo libero)datetime-local (gg/mm/aaaa-hh:mm)-->
<input type="date" name="date" min="01-01-1900" required></br></br>
<label for="mail">Email</label></br>
<input type="mail" name="mail" required></br></br>
<label for="sito">Il tuo sito web</label></br>
<input type="url" name="sito" placeholder="https://" required></br></br>
<label for="colore">Il tuo colore preferito</label></br>
<input type="color" name="colore" required></br></br>
<label for="gradimento">Gradimento</label></br>
<input type="range" name="gradimento" required></br></br>
<label for="allegacv">Allega il CV</label></br>
<!--possiblita di limitare la tipologia
di file accettate con accept seguito dai formatiaccettati-->
<input type="file" name="allegacv" accept=".docx,.pdf" required></br></br>
<!--raggruppamento di campi-->
<fieldset>
  <!--descrizione del raggruppamento-->  
<legend>Scegli il sesso</legend>
      <!--radio button richiede se raggruppati utlizzare lo
      stesso name di attributo ma valori diversi in value
      che è un attributo obbligatorio-->  
   <input type="radio" name="sesso" value="maschio">Maschio
   <input type="radio" name="sesso" value="femmina">Femmina
   <input type="radio" name="sesso" value="nonrisposta" checked>Non rispondere
</fieldset>
<label for="servizio">Seleziona il servizio</label></br>
<!--Select è il ragrppumento delle scelte per piu opzioni
aggiungere l'attributo "multiple"--> 
<select required>
  <!--per i valori da selezionare si usa option 
  e ha due attributi un obbliglatori tra cui value 
  mentre se voglio preselezione una scelta uso 
  l'attributo selected-->
   <option value="grafica">Grafica</option>
    <option value="web design" selected>Web Design</option>
</select></br></br>
<label for="messaggio">Messaggio</label></br></br>
<!--textare ha attributi di larghezza cols e rows 
e numero di righe-->
<textarea name="messaggio" 
cols="30" rows="5"
required></textarea></br>


<label for="privacy">Privacy Policy</label></br>
<input type="checkbox" required>Accetta la
 nostra politica sulla privacy</br>

<!--infine abbiamo un input di invio delle informazioni
submit è un type per inviare informazioni
reset per cancellare il valore dei campi stessi-->
<input type="submit" value="Invia Ora">
<input type="reset" value="Cancella tutto">

<!--type password 
<label for="pass">Email</label></br>
<input type="password" name="pass" required></br></br>-->

</form> 
 </div>
</body>
</html>
