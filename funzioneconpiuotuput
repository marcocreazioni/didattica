<p id="redditodisponibile"></p>


 <script>

function temporiempimento() {
    var vascadabagno = 300;
   /*300 è la capienza in litri */
    var acquametrocubo = "1 mc";
    var acquametrocuboanumero = parseInt(acquametrocubo);
    /*1 metro cubo al secondo */ 
var conversioneinlitri = acquametrocuboanumero * 1000;

 
    return vascadabagno / conversioneinlitri; 


}



function calcoloirpef() {
let redditoinput = Number(document.getElementById("reddito").value);//il reddito deve diventare un numero
const aliquota = 15;

let irpef = redditoinput * (aliquota / 100);
var netto = redditoinput - irpef;  

 /* return restituisce solo il risultato ma non fa altre attivita */   
 // return irpef 
 /* in alternativa stampa direttamente la variabile che resitutisce il risultato 
   stampareddito.innerHTML = "l'irpef ammonta a : " + irpef + " €";
*/
stampareddito.innerHTML = "l'irpef ammonta a : " + irpef + " €";
redditodisponibile.innerHTML = "il reddito restante è il seguente: " + netto + " €";

     
}



document.write("<br>" + temporiempimento() + " è il tempo in secondi che impiega la vasca a riempirsi");

/* function + nomefunzione + (argomenti-variabili obbligatorie) {operazioni
da svolgere la funzioni } */
function stampanominativo() {
      a = document.getElementById("nome").value; //stringa
      b = document.getElementById("cognome").value; //stringa
      //per convertire il valore di un campo da stringa a numero
      c = Number(eta.value);
      //definizione aoutput 
      x.innerHTML = a + " " +  b + "di età:" + c;
     }
