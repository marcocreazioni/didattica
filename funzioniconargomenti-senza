<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Funzioni</title>
<style>
:root {  
--color: orange;

}    
body {margin:30px;
    background-color: antiquewhite;
     

}  
.separatore {border-right: 2px solid;
             border-bottom: 2px solid;
             border-color: var(--color);
             width: 50%;
             height: 200px;

            

}

</style>



</head>
<body>
<h1>Funzioni</h1>
<div class="separatore">

<label for="nome">Nome</label><br>
<input type="text" name="nome" id="nome"><br>
<label for="cognome">Cognome</label><br>
<input type="text" name="cognome" id="cognome"><br><br>
<label for="eta">Età</label><br>
<input type="number" name="eta" id="eta"><br><br>

<!--attivatore funzioni js che si vanno aggiungere agli oggetti:
onclick: al click del mouse
onmouseover: al passaggio del mouse
ondoubleclick: al doppio clicc del mouse 
onload: al caricamento del contenuto
onkeypress: alla click del tasto della tastiera-->
<input type="submit"  onclick="stampanominativo()" value="stampa nominativo"> 

 </div>
<p id="x"></p>
 <script>
/* function + nomefunzione + (argomenti-variabili obbligatorie) {operazioni
da svolgere la funzioni } */
function stampanominativo() {
      a = document.getElementById("nome").value; //stringa
      b = document.getElementById("cognome").value; //stringa
      //per convertire il valore di un campo da stringa a numero
      c = Number(eta.value);
      //definizione aoutput 
      x.innerHTML = a + " " +  b + "di età:" + c;
     }
/* funzione con argomenti */
function areatriangolo (base,altezza) {
       return base * altezza;

}
/* richiamo della funzione bivalore */
document.write(areatriangolo(prompt("inserisci la base",""),prompt("inserisci l'altezza","")));

 </script>
 
</body>
</html>
