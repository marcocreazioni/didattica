<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Funzioni JS</title>


</head>
<body>
    <h1>Funzioni in JS</h1>
<script>
/* ricorda creare una variabile non comporta sempre assegnargli un valore in quanto
puo essere fatto anche successivamente */    
var c; 
/* successivamente alla variabile c assegno il valore 10 */  
c = 10; 
// Le funzioni possono essere collegati ad eventi 
/* per creare una funzione scriviamo function + il nome della funzione
le funzioni servono a svolgere operazioni + (elementi e o variabili che comporronnao la
funzione) se non indichiamo valori()in parentesi stiamo
indicando che la funzione non necessita di argomenti o variabili specifiche + { qui deveono essere indicate
le operazioni che le funzioni devono svolgere } */
function stampa() {
    /* Esempio di funzione che stampa un testo usando return si specifica il risultato da ottenere */
   return ("il cane fa bauuu");
}
/* in uno step successivo una volta che la funzione è stata implementata per esser utilizzata
deve essere richiamata,ed indicare gli argomenti della funzioni se previsti 
ATTENZIONE quando richiamo una funzione anche se la funzione non ha argomenti, devo almeno indicare
la tipologia di dato che verra pubblicato nell'esempio in questione una stringa */
document.write(stampa("") + "<br>");

/*_______________________________*/
/* una funzione puo utlizzare delle variabili esterne alla funzione a patto che siano
assegnate PRIMA DELLA FUNZIONE STESSA altrimenti riceveremo un errore di non assegnazione
"Undefined" */
var ciao = "Benvenuto";

function nome() {
/* le variabili implementate in una funzione sono ad uso e consumo di questa funzione */
var a = prompt("inserisci il nome:  ", " ");
/* uso la variabile ciao che è esterna alla funzione al quale ho aggiunto uno spazio
e successivamente aggiungo ed esso una variabile interna alla funzione*/ 
return ciao + " " + a + "<br>";  

}
document.write(nome(""));

/*____________________________*/
/* in una funzione posso indicare come argomenti/parametri anche variabili non assegnate */ 
function somma(numero1,numero2){
   /* i paramenti o gli argomenti della funzione possono essere assegnati a delle variabili */
    var sum = numero1 + numero2;
    return sum;
}
/* i valori/argomenti della funzione saranno assegnati al momento dell'applicazione delle funzione */ 

document.write(somma(5,10)+ "<br>");

function moltiplica(num3,num4) {
    var prodotto = num3 * num4
    return prodotto; 
}
document.write(moltiplica(3,10)+ "<br>") ;
</script>
</body>
</html>
