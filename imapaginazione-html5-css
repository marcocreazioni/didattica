/* Creazione di un documento esterno 
TAG HTML O UNA CLASSE O UN ID DA MODIFICARE (SELETTORE) { (INDICAZIONI DELLE PROPRIETA DI MODIFICARE) : VALORE DA MODIFICARE (E' POSSIBILE INSERIRE
SOLO VALORI AMMESSI DALLA PROPRIETA) }   
*/
/*tag*/
body { 
    /* cambia lo sfondo del testo */
    background-color: antiquewhite;
    /* colore del testo */
    color: black;
    /* allineamento del testo text-align (center,left,right,justify, start, end) */
    text-align: center;
    /* larghezza e altezza (px, em, Vv, %) */
    width: 90% ;
    /* auto indica un valore automatico per l'altezza */
    height: auto;

      

}
