<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Impaginazione Flexbox</title>
    <style>
* {box-sizing: border-box;

}
body {font-family: sans-serif;
      padding: 0px;
      margin: 0px;
}
/* per la impaginezione flexbox i contenitori devono essere quelli piu grandi */

.contenitore { background-color: transparent;
/* I step  al contenitore che include i contenitori piu piccoli 
diamo e attiviamo le proprieta flexbox display*/ 
               display: flex;
/* proprieta di configurazione display flex 
flex-direction stabilische come devono essere ordinati
i contenuti (row) riga (coloumn) in colonna aggiungendo
a row + reverse otteniamo un ordine inverso (row-reverse)*/
               flex-direction: row;
/* con flex wrap i contenenitori diventano fluidi e si distribuscono
meglio gli spazi disponibili*/               
               flex-wrap: nowrap;
/* possiamo applicare delle distanze tra i blocchi usando la proprieta 
gap: distanza tra i blocchi*/
                gap:3px;
                margin-top: -10px;
                margin-left:10px;
                margin-right:10px;
                
                

}
.box1 {background-color: bisque;
       /*attivato il contenitore flex le singole box possono 
       utilizzare le proprieta flex */
       /* i valori di flex stabiliscono la proporzione dei contenitori */
       /* flex grow annulla la proprieta flex e allarga la box nel contenitore
       flex-grow: 1; */
       /* flex-shrink rende responsivo un solo blocco (prerequisito e avere
       la flex-wrap: nowrap) che sia addatta allo schermo mentre gli altri blocchi
       rimangono inalterati  senza addattarsi allo schermo
       flex-shrink: 1; */
       padding: 2px;
       flex: 1;
       border-bottom-left-radius: 10px;
       border-top-left-radius: 10px;
              
}
.box2 {background-color: azure;
        padding: 2px;
        flex: 1;
}
.box3 {background-color: darkseagreen;
    
       flex: 1;
       padding: 2px;
       border-bottom-right-radius: 10px;
       border-top-right-radius: 10px;
}
.contenitore2 {
    display: flex;
    margin-top: 10px;
    margin-left:10px;
    margin-right:10px;
    flex-direction: column;
   

}
.box4 {background-color: rgb(116, 18, 196);
       background-image: url('https://cdn.pixabay.com/photo/2025/07/17/14/14/sparrow-9719599_960_720.jpg');
       background-attachment: scroll;
       background-size: cover;
       background-position: center; 
        padding: 0px 0px 200px 10px; 
        flex: 1;
        height: 400px;
       

   
}
.box4 button {margin-left: 45%;
              background-color: lightskyblue;
              border: none;
              border-radius: 15px;
              padding: 10px;
              color: white;

}
            

.box5 {
        padding: 2px;
        flex: 1;
        color:brown;
        text-shadow: 1px 1px 0px white;


}

    </style>
</head>
