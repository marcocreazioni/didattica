<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
/* Proprieta css che si applica a tutta la pagina */ 
* {font-family: sans-serif;}
/*Proprieta che condiziona solo il corpo pagina */
body {
   margin: 5%; 
}
/* Alcune accortezza per il design responsivo:: margini in %, larghezza in %;
e proprieta automatiche per l'altezza  o fit-content */
img {
    width: 50%;
    height: auto;
/* Larghezza massima del contenuto all'ingrandimento dello schermo */
    max-width: 600px;
/* min-width imposta invere la larghezza minimo dove non è possibile 
diminuire l'oggetto alle dimensioni minime delle schermo */
    min-width: 300px;

/* le immagini possono essere corrette nel css medienta l'uso di
filtri il cui parametro viene applicato in % 

    blur(50%)
    "sfocatura"
    brightness()
    "luminosita"
    contrast()
    "contrasto"
    drop-shadow()
    "ombreggiature"
    grayscale()
    "scala di grigio"
    hue-rotate()
    "scostamento dei colori"
    invert()
    "effetto negativo"
    opacity()
    "trasparenza"
    saturate()
    "Quantita di colore nell'immagine"
    sepia()
    effetto seppia

*/
   filter: sepia(90%);
   border-radius: 50%;
   
}
a:hover {color: red;
} 
a:visited {color:black:
}         
img:hover {
        box-shadow: 10px 10px red;
}

/* stati dell'attivita del mouse che vengono indicate con i due punti
! :active (al caricamento della pagina) :linked (valido solo per i collegamenti)
:hover (comportamento al passaggio del mouse) :visited (alla visita)
*/

/* ALtre proprieta del testo */
p { 
    font-size: large;
    /*interlinea */
    line-height: 1.5;
    /*rientro del paragrafo */
    text-indent: 5%;
    /*ombreggiatura con text shadow inserendo lo scostamenteo orizzonale
    e il primo parametro e il secondo parametro e lo scostamento seguito
    dal colore e possibile inserire la sfocatura*/

    text-shadow: 1px 1px 0.1px black;
    /*distanza tra o caratteri */
    letter-spacing: 1px; 
    /*distanza tra le parole */
    word-spacing: 1px;
}
div {
    /*short code del border: 1 pratmetro spessore tipologia e colore */
    border:0.5px solid orange;
    /* arrotondamento su tutti i 4 lati del bordo */
    border-radius: 5px;
    /* il rientro del contenitore rispetto al contenuto */
    padding: 2%;
    /* ombreggiature applicata al contenitore; parametri: scostamento
    orizzontale e verticale, facoltativamente un terzo parametro
    sta indicare la sfumatura e l'ultimo parametro e il colore */
    box-shadow: 2px 2px 10px orange;
}

</style>

<body>
 <div>
