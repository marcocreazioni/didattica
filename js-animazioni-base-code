<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
<style>
#container {
  width: 400px;
  height: 400px;
  position: relative;
  background: yellow;
}
#animate {
  width: 50px;
  height: 50px;
  position: absolute;
  background: red;
}

</style>
</head>
<body>
<p><button onclick="myMove()">Click Me</button></p>
<div id ="container">

    <div id ="animate">Animazione qui</div>

</div> 
<script>
function myMove() {
//implementazione della variabile di reset
    let id= null;
//preliveo dell'oggetto da animare    
    const elem = document.getElementById("animate");   
    let pos = 0;
 //azzeramento iniziale   
    clearInterval(id);
//riassegnazione dell'id e di tutte le variabili in generale
//Set interval (indica la fluidita di ogni singolo frame)    
     id = setInterval(frame, 5);
//funzione di movimento di frame 
function frame() { 
                   //festinazione rispetto al contenitore
                  if (pos== 350){  
                      clearInterval(id);
                  }
                  //direzione dell'animazione
                  else {
                        pos++; 
                        elem.style.top = pos + "px"; 
                        elem.style.bottom = pos + "px";  
                  }
                  }     
//chiusra my moovye
}

</script>

</body>
</html>
