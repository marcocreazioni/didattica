<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documento</title>
<style>
div {margin:auto;
     width:75%;
     background-color:cyan;
     padding:5px; 
     border-radius: 15px;
     margin-top:20px;
     overflow: auto;
}
button {padding:4px;
        border: none;
        background-color: chocolate;
        color:white;
        margin-left:10px; 
    }
img {width: 100%;
     height: 300px;}    

</style>    
</head>
<body>

<div id="blocco">    
<h1 id="titolo">Il mio titolo</h1>
<p id="paragrafo">Lorem ipsum dolor sit amet consectetur adipisicing elit.
     Minima quis similique quae, sapiente quas consequuntur nemo ea voluptatum, 
     harum neque mollitia alias vel laborum dignissimos eius? Quos nulla tempora ducimus!
</p>
<img id="foto" src="https://cdn.pixabay.com/photo/2025/10/30/08/30/rabbit-9926492_960_720.jpg"><br>

<button onclick="cambiasfondo()">cambiare sfondo</button>
<button onclick="allineatitolo()">centra</button>
<button onclick="sistemaparagrafo()">sistema</button>
<button onclick="cambiafoto()">foto</button>

    </div>

<script>
function cambiasfondo() {
  document.getElementById("blocco").style.backgroundColor = "orange";

}
function allineatitolo() {
    titolo.style.textAlign = "center";
}
function sistemaparagrafo() {
    paragrafo.style.textAlign = "justify";
    paragrafo.style.fontFamily = "sans-serif";
}
function cambiafoto() {
    foto.src = "https://cdn.pixabay.com/photo/2022/12/19/21/44/golden-7666646_960_720.jpg";
    foto.alt = "palla di neve";

}

</script>



</body>
</html>
