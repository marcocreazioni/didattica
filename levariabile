<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
</head>
<body>
    <h1>Operare con le variabili</h1>
<p>Tiplogie di variabili</p>
<ul> 
<li id="a"></li>
<li id="b"></li>
<li id="c"></li>
<li id="d"></li>
<li id="e"></li>
<li id="f"></li>
<li id="g"></li>
<li id="h"></li>
<li id="i"></li>
<li id="l"></li>
<li id="m"></li>
</ul>




<script>
//dichiarazione di una variabile
var prima;
//assegnazione del valore alla variabile
prima = 10; //number integer
//+ permette di stampare una concatenazione di valori 
a.innerHTML = prima + " " + typeof(prima);
//dichiarazione e assegnazione di una variabile con decimali
var seconda = 10.5; //number float

b.innerHTML = seconda + " " + typeof(seconda);

var terza = 2e8; //number esponential
c.innerHTML = terza + " " + typeof(terza);

var quarta = "50";
d.innerHTML = quarta + " " + typeof(quarta); //stringa di testo 
//attenzione non è possibile effetture operazioni tra stringe numero 
//perchè genera un errore NaN (non è un numero)
//per operare con le strighe e con i numeri bisogna trovare un compromesso ed effettura una conversione

var quinta = true;
e.innerHTML = quinta + " " + typeof(quinta); //true o false (e possono essere generate automaticamente
//mediante gli operatori "> + < + >= + == + ===" ) 

var sesta = ["pane","pasta","sale"];
//insieme di valori della stessa tipologia crea un array ovvero un elenco
f.innerHTML = sesta + " " + typeof(sesta);

var settima = {
    veicolo: "fiat",
    modello: "500",
    numero: 1
}
g.innerHTML = settima.veicolo + " " + settima.modello + " " + settima.numero + " " + typeof(settima);

</script>

</body>
</html>
