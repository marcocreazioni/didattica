    <body>
<!--connessione a facebook-->
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/it_IT/sdk.js#xfbml=1&version=v22.0"></script>

        <header>
           <h1>Inserimento di un popup </h1>
        </header>
        <!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
    Bottone di attivazione
  </button>
  
  <!-- Modal -->
  <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <!--contenuto del popup-->
    <div class="modal-content">
 <!--Modal title -->
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="exampleModalLabel">Seguici su facebook</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
   <!-- Corpo del popup -->     
        <div class="modal-body">
    <!--Plugin sociali -->
    <div class="fb-page" style="width: 100%;"  data-href="https://www.facebook.com/BarillaIT/?locale=it_IT" data-tabs="timeline"  data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="false"><blockquote cite="https://www.facebook.com/BarillaIT/?locale=it_IT" class="fb-xfbml-parse-ignore"><a href="https://www.facebook.com/BarillaIT/?locale=it_IT">Barilla</a></blockquote></div>
   
  
        </div>
     
<!--Pie di pagina-->

<!--     <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
          
        </div>
-->

      </div>
    </div>
  </div>
  




