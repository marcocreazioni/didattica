<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
form {background-color: antiquewhite;
      margin: 20px;
      padding: 20px;
      border-radius: 5%;
      border: 1px solid orange;
}
h1 {text-align: center;
}
label {color: purple;
       font-family: sans-serif;
       font-size: smaller;
}
.input-text {width: 100%;
       font-size: smaller;
       font-family: sans-serif;

}
span {font-size: xx-small;
    font-family: sans-serif;

}
.invia {background-color: chartreuse;
        padding: 2px;
        color:blue;
        border-radius: 5%;
        width: 50%;
        margin: auto;

}
    </style>
</head>
<body>
    <h1>Modulo -Form</h1>
    <!-- form è il contenitore del modulo 
     e ha attributi obbligatori come: 
     "action" (file inviate tramite email(si usa l'inidirizzo
     del sito web)) o si inserisce il percorso
     del file che processera le informazioni
      nel caso del php o bisogno di definire il metodo
      devo aggiungere l'attributo obbligatorio
      "methods:" che ammette solo 2 valori "get" o 
      "post". 
     ci sono poi attributi facoltativi:
     autocomplete: "on" informazioni memorizzate dal browser
     per il completamento del modulo. "off" Invece impedisce
     l'auto completamento
      -->

    <form action="inviomail.php" method="post" title="modulo info" autocomplete="on">
     <!-- label è l'etichetta del campo-->
      <label>Nome*</label>
      <!--field campo di inserimento input  
      Attributi obbligatori:
      type = tipologia di informazione da inserire
            valori ammessi:
            text = riga di testo
            mail = ammette solo mail 
            tel  = ammette solo numeri 
            number = ammette solo numeri
            date = ammette solo date come valori
            datatime-local = ammette sia data che ora
            color = ammette solo colori
            radio = ammtte il riempimento del cerchio di selezioine
            checkbox = inserische una casella di spunta
            file = consente di caricare dei file in allegato 
            url = ammette solo indirizzi https ecc 
            password = ammette contenti nascosti
            search = ricerca nella stessa pagina del form
            reset = azzera la compilazione di un modulo (button)
            submit = serve per inviare all'action le informazioni (button)

      name= definizione di un nome per riconoscere l'informazione da prelevare      
      Attributi facoltativi
      placeholder = testo segnaposto "inserire il testo segnaposto"
      value = attribuzione di un valore preimpostato ma che puo essere sovrascritto "valore da inserire"
      required = obbliga l'utente alla compilazione del modulo 
      autocomplete = on o off per un singolo campo
      readonly = campo di sola lettura
      pattern = rappresenta la formattazione obbligatoria di un campo
             i valori ammessi sono o solo lettere [A-Za-z] o solo numeri [0-9] seguito dal
             numero di cifre o lettere tra parentesi graffa {2}
     minlength = numero minimo di caratteri o cifre presenti nel campo
     maxlength = numero massimo di caratteri o cifre 
     min = numero minimo ammesso
     max = numero massimo ammesso
     per le date aggiungiamo a min e max datemax per indicare una data massima e datemin
     per indicare una data minimo
     step = solo per i numeri indica l'interavallo prossimo tra un nmero precedente e successivo
     ad step = 10 seleziona i numeri di 10 in 10 (10)(20)(30)  
     checked = selezionato e uncheked non selezionato 
     accept e size decidono i formati ammessi e le dimensioni in bit
        -->
     <input class="input-text" type="text" name="nome" placeholder="inserisci il nome" autocomplete="off" required>
     <label>Cognome</label>
     <input class="input-text" type="text" name="cognome" placeholder="inserisci il cognome" autocomplete="off" required>
     <label>Mail</label>
     <input class="input-text" type="mail" name="mail" placeholder="inserisci la tua mail" autocomplete="off" required>
     <label>Telefono</label>
     <input  class="input-text" type="tel" name="telefono" placeholder="333-123456" pattern="[0-9]{3}-[0-9]{6}" required>
     <label>Partita Iva</label>
     <input type="text" name="partitaiva" placeholder="IT02322444" pattern="[A-Za-z]{2}[0-9]{14}" minlength="16" maxlength="16">
     <label>Età</label>
     <input  class="input-text" type="number" name="eta" min="18" max="90">
     <label>Data di registrazione</label>
     <input class="input-text" type="date" name="registrazioni">
     <label>Il tuo colore preferito</label>
     <input class="input-text" type="color" name="colore">
     <label>Sesso</label><br>
     
     <!--l'attributo for applicato a label serve per concatenare
     l'etichetta all'input type-->
     
     <input type="radio" name="sesso1" id="sesso1" name="maschio" value="Maschio" checked>
     <label for="sesso1">Maschio</label><br>
     <input type="radio" name="sesso2" id="sesso2" name="femmina" value="Femmina">
     <label for="sesso2">Femmina</label><br>
     <br><br>
     <input type="submit" class="invia" value="INVIA"><br>
     <span>* l'asterisco indica che si tratta di un campo obbligatorio</span>
    </form>
</body>
</html>
