// INcrementare il valore di una variabile
var x; // Declaring Variable
 
x = 10;
alert(++x); // Outputs: 11
alert(x);   // Outputs: 11
 
x = 10;
alert(x++); // Outputs: 10
alert(x);   // Outputs: 11
 
x = 10;
alert(--x); // Outputs: 9
alert(x);   // Outputs: 9
 
x = 10;
alert(x--); // Outputs: 10
alert(x);   // Outputs: 9

// calcoli sulla logica
var year = 2025;
// && = significa che devono verifica entrambe le condizione stabilita e nei calcoli logici && = and 
// || = significa che si deve verficare o una condizione o un altra quidni l'una esclude l'altra nei calcoli
// logici equivale ad OR ('oppure')
// != = significa che non deve verificarsi quella condizione e nei calcoli logici è = a not (non deve verificarsi)


// Un anno per essere bisestile deve essere divisibile per 4 o per 400 se non lo è non è bisestile
// if se (condizione che si deve verificare){ operazione da fare se si verifica la condizione }
// altrimenti se non si verifica la condizione di if "else" { effutta l'operazione inserita nella parentesi graffa}
if((year % 400 == 0) || ((year % 100 != 0) && (year % 4 == 0))){
    alert(year + " è un anno bisestile");
} else {
    alert(year + " non è un anno bisestile.");
}

// legati ad i calcoli logici  il confronto e restituisce comeri risultato vero o falso
var x = 25;
var y = 35;
var z = "25";
 
alert(x == z);  // Outputs: true (vero) == uguale a 
alert(x === z); // Outputs: false (non proprio identi perche sono numero e stringa) === identico a
alert(x != y);  // Outputs: true (vero è diverso ) != diverso da 
alert(x !== z); // Outputs: true  (vero non è identico ) !== non identico a
alert(x < y);   // Outputs: true (vero) < minore di
alert(x > y);   // Outputs: false (falso) > maggiore di 
alert(x <= y);  // Outputs: true (vero) <= minore o uguale 
alert(x >= y);  // Outputs: false (falso) >= maggiore o uguale


