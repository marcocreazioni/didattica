// Operatori Logici - In sistemi condizionali 
// && = and (comporta che due condizioni debbano verifica )
// || = or (comporta che si deve verificare almeno 1 di due condizione)
// != not (non deve verificarsi una particolare condizione)

var year = 2025;
 
// calcolo dellìanno bisestica
// if indica il se (condizione) { fai questo operazioni }
if ((year % 400 == 0) || ((year % 100 != 0) && (year % 4 == 0))){
    alert(year + " l'anno è bisestile.");
}
/* else = altrimenti (se la condizione non si verifica) { fai questa altra operazione } (in mancanza di else
svolgere solo l'operazione della condizione verificata) */
 
else
 {
    alert(year + " l'anno non è bisestile.");
}
// operatori di confronto utili per le variabile e gli operatori logici
var x = 25;
var y = 35;
var z = "25";
 
alert(x == z);  // Outputs: true (vero uguale a(si ferma al contenuto della variabile))
alert(x === z); // Outputs: false (falso identico a (uguale nel contenuto e nella tipologia))
alert(x != y);  // Outputs: true (vero diverso da (si ferma sempre al contenuto della variabile) )
alert(x !== z); // Outputs: true (vero non identico(per contenuto e tipologia))
alert(x < y);   // Outputs: true (vero x è minore di y )
alert(x > y);   // Outputs: false (falso x non è (maggiore) di y )
alert(x <= y);  // Outputs: true (vero (minore di o uguale a) )
alert(x >= y);  // Outputs: false (falso (x non è maggiore di y)) )






