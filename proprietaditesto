}
/* text indent lascia lo spazio nella prima riga */
.p3 {text-indent: 20px; 
/* famiglie di caratteri */
     font-family: arial,sans-serif; 
     /*ritaglia il teso dentro un contenitore */
     text-overflow: clip;    
}
        
a {text-decoration: none;

}
.prova {text-decoration: overline;

}
