<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
<style>
.scatola {width: 50%;
          height: 300px;
          background-color: beige;
          background-image: url('https://cdn.pixabay.com/photo/2025/06/07/14/26/trees-9646443_960_720.jpg');
          color:white;
          overflow: auto;
          text-align:center;
          border-radius: 5%;
}
.scatola2 {width: 50%;
          height: 300px;
          background-color: beige;
          background-image: url('https://cdn.pixabay.com/photo/2025/08/15/07/25/ai-generated-9776380_960_720.jpg');
          color:white;
          overflow: auto;
          text-align:center;
          border-radius: 5%;
}
section {display:flex;
      gap:5px;

}
/* proprieta degli schermi non piu grandi di 380px (smartphone o cellulari) */
@media only screen and (max-width:380px) {

    section {display:flex;
         flex-direction: column;
         flex-wrap: nowrap;


}
   .scatola , .scatola2 {
    width:100%;
}

}
/*schermi piu grandi di 380px e piu piccoli di 1064px (tablet) */
@media only screen and (min-width: 380px) and (max-width:1064px) {
  
  .scatola , .scatola2 {
    font-size:large;
    width:100%;
    color: yellow;

}
}
</style>
</head>
<body>
    <h1>Responsive</h1>
<section>

    <div class="scatola">
     <p>Testo</p>
     <button>Clicca qui</button>

    </div>
    <div class="scatola2">
        <p>Testo</p>
     <button>Clicca qui</button>

    </div>

 </section>   
</body>
</html>
