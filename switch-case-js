<script>
function chocolate(){ 

    var preferenza = document.getElementById("x").value;
       //if identifica la condizione da verificare 
       //(formula condizionale che restituisce un valoree booleano "vero o falso")--Nell'if diamo per scontato che la formula
       //ci restituisca sempre un valore vero 

       //operatori condizionali ( > , >= , == , ===, < , <==)
       //dentro swich indichi cosa vuoi verificare (nel nostro case il risultato della variabile preferenza)
    switch (preferenza) {
//I condizione  case - valori che puo assumere una variabile (attenzione! alla tipologia di variabile inserita)
        case "fondente": 
         //azione da effettuare se la variabile assume quel valore
        document.write("bene ti piace la cioccolata fondente");
         //break serve ad interrompere una condizione se tutte le altre si verificano
        break;
             
 //II condizione    
       case "latte":
       document.write("bene ti piace la cioccolata al latte");
       break;
     
//III condizione
       case "bianca":
       document.write("bene ti piace la cioccolata bianca");
       break;
//IV  condizione o tutte quelle non disciplinate non si verificano
      default: 
      document.write("bene ti piace la cioccolata ruby");
      }

}    

