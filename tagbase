<!DOCTYPE html>
<!--ogni tag puo avere degli attributi che cambiano il comportamento
del tag,-->
<html lang="it">
<!--Istruzione per il browser e i motori di ricerca-->
<head>
  <!--charset attributo che informa che la pagina usa caratteri latini-->
    <meta charset="UTF-8">
    <!--istruzione che indica alla pagina di scalare di 1.o i contenuti dello schermo-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--per la seo occorrono almeno 70 caratteri -->
    <title>Titolo presente sulla scheda</title>
    <!--per la seo la descrizione deve essere almeno 160 caratteri-->
    <meta name="description" content="descizione del contenuto della pagina">
    <!--Per i siti che trattano un solo argomento (pneumatici) (keyword stuffling)-->
    <meta name="keyword" content="titolo, titolo scheda, scheda titolo, titolo roma">
     <!--istruzione per l'indicizzazione o meno dei contenuti (spybots,bots,crawler)(index indicizza)
     (no index se non vogliamo indicizzarlo), follow(per seguire i link)no follow(non seguire i link) 
     (none) sostituisce sia il no inedex che il no follow-->
     <meta name="robots" content="index,follow">
     <!---meta tag facoltativamente-->
     <meta name="google" content="notranslate">
     <meta mane="author" content="Marco">
     <meta name="generator" content="visual studio code">
     <!--ogp-me-->
     <meta property="og:title" content="Titolo della scheda" />
     <meta property="og:type" content="article" />
     <meta property="og:url" content="https://miosito.it" />
     <meta property="og:image" content="https://ia.media-imdb.com/images/rock.jpg" />
