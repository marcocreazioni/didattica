<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
.box-1 {width: 150px;
        height: 150px;
        background-color: blanchedalmond;
        border:1px brown solid;
        overflow: hidden;
        /*proprieta transition 
        si attiva soltando quando abbiamo
        lo stesso oggetto con le proprita hover
        indicando le proprieta e la durata
        della transizione da attivare*/
        transform: rotate(0deg);
        transition: width , height , border , background-color, transform ;
        /* Stabilisce il ritardo della transizione */
        transition-delay: 50ms; 
        /* Transition duration stabilisce durata in s o ms 
        di tutta la transizione */
        transition-duration: 5s;
        /* funzione di accellerazione e decelerazione
        dell'animazione 
        con i parametri piu utilizzato 
        ease in (accelera all'inizio decelera alla fine)
        linear (mantiente la stessa velocita dell'animazine)
        easi out(accelera solo al termine della transizione)
        easi in-out (accelera all'inizio e al termine della transizione)*/
        transition-timing-function:linear;
    }  
/*transition */
.box-1:hover {
        width:50px;
        height:50px;      
        border: 10px brown solid;
        background-color: orange;
        transform: translate(200px, 0px) rotate(45deg);
} 

    </style>
</head>
<body>
    <h1>Transition</h1>
    <div class="box-1">&nbsp;</div>   



</body>
</html>
